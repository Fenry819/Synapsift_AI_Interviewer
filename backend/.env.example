# Copy to .env (git-ignored) and fill in. Every value except the keys is optional.

# --- Hosted providers ---
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY=
JWT_SECRET=change-me

# --- Local LLM (Ollama): used when OpenRouter fails, and as the evaluation fallback ---
# Any model Ollama can serve. The code never names a specific model except this default.
LOCAL_LLM_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Context window requested from Ollama. Larger values need more VRAM (KV cache grows with it).
LOCAL_LLM_NUM_CTX=4096
LOCAL_LLM_TIMEOUT_SECONDS=300

# --- OpenRouter tuning (optional) ---
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_TIMEOUT_SECONDS=60
